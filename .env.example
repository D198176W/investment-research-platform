# .env 示例文件
# 复制此文件为 .env 并填入实际配置

# DashScope API Configuration
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Gateway Configuration
APP_NAME=智能投研平台
APP_VERSION=2.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# LLM Configuration
DEFAULT_MODEL_NAME=qwen-plus

# 独立风控审核官模型（分析-审核双角色，建议与主模型不同）
REVIEWER_MODEL=qwen-max

# ==================== v2: Agent 工程能力配置 ====================

# Agentic 感知（工具调用循环）
USE_AGENTIC_PERCEPTION=True
AGENTIC_MAX_ROUNDS=8

# Reflector 反思
MAX_REFLECTION_LOOPS=1

# 记忆与上下文
MEMORY_MAX_ITEMS=200
CONTEXT_MAX_TOKENS=30000
CONTEXT_RESERVE_OUTPUT=2000

# 多模型路由
HEAVY_MODEL=qwen-max
LIGHT_MODEL=qwen-turbo
FALLBACK_MODEL=qwen-plus
